{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beacon Motive",
  "version": "0.1.0",
  "identifier": "dev.beacon.motive",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Beacon Motive", "width": 1180, "height": 760, "minWidth": 860, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
